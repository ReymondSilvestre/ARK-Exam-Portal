rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function me() { return get(profilePath()).data; }
    function liveAccount() { return hasProfile() && me().status == 'active' && me().mustChangePassword != true; }
    function isAdmin()   { return liveAccount() && me().role == 'admin'; }
    function isTeacher() { return liveAccount() && me().role == 'teacher'; }
    function owns() { return resource.data.ownerUid == request.auth.uid; }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // Only an admin may create profiles, and only teacher profiles (never another admin).
      allow create: if isAdmin()
        && request.resource.data.role == 'teacher'
        && request.resource.data.uid == uid
        && request.resource.data.status == 'active'
        && request.resource.data.mustChangePassword == true;

      // Admin: change a teacher's status only. User: clear their own first-login flag only.
      allow update: if
        (isAdmin() && resource.data.role == 'teacher'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['active', 'suspended'])
        ||
        (signedIn() && request.auth.uid == uid && resource.data.mustChangePassword == true
          && request.resource.data.mustChangePassword == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'passwordChangedAt']));

      allow delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Password-reset requests. Anyone (even signed out) may file ONE well-formed pending request;
    // only the IT admin can read them or mark them handled. Nothing is emailed until the admin acts.
    match /resetRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'employeeId', 'status', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 4 && request.resource.data.email.size() < 150
        && request.resource.data.employeeId is string && request.resource.data.employeeId.size() < 40
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.status in ['sent', 'dismissed'];
      allow delete: if false;
    }

    match /systemSettings/{id} {
      allow read: if liveAccount();
      allow write: if isAdmin();
    }

    // Teacher-owned data (used from Phase 2 onward).
    match /{coll}/{id} {
      allow read:   if coll in ['classes','students','examinations','answerKeys','answerSheets','scanResults']
                       && (isAdmin() || (isTeacher() && owns()));
      allow create: if coll in ['classes','students','examinations','answerKeys','answerSheets','scanResults']
                       && isTeacher() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if coll in ['classes','students','examinations','answerKeys','answerSheets','scanResults']
                       && isTeacher() && owns()
                       && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if coll in ['classes','students','examinations','answerKeys','answerSheets','scanResults']
                       && isTeacher() && owns();
    }
  }
}
