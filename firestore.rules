rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()    { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile()  { return signedIn() && exists(profilePath()); }
    function me()          { return get(profilePath()).data; }
    function liveAccount() { return hasProfile() && me().status == 'active' && me().mustChangePassword != true; }
    function isAdmin()     { return liveAccount() && me().role == 'admin'; }
    function isTeacher()   { return liveAccount() && me().role == 'teacher'; }
    function isStaff()     { return isAdmin() || isTeacher(); }          // the IT admin has every teacher feature
    function isStudent()   { return liveAccount() && me().role == 'student'; }

    function studentRec(sid) { return get(/databases/$(database)/documents/students/$(sid)).data; }
    function myStudent()     { return studentRec(me().studentId); }
    // a document the student may see: same teacher, and either their own section or "all sections" (classId == '')
    function studentSees(ownerUid, classId) {
      return isStudent() && ownerUid == myStudent().ownerUid && classId in [myStudent().classId, ''];
    }
    // For READS: a document that does not exist yet has resource == null. Without this check the
    // "does this result already exist?" lookup done by the scanner is denied (the old permission error).
    function mayRead()  { return resource == null || resource.data.ownerUid == request.auth.uid; }
    function owns()     { return resource.data.ownerUid == request.auth.uid; }
    function mine()     { return request.resource.data.ownerUid == request.auth.uid; }
    function sameOwner(){ return request.resource.data.ownerUid == resource.data.ownerUid; }

    /* ---------------- accounts ---------------- */
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if request.resource.data.keys().hasOnly(
            ['uid','role','displayName','email','employeeId','studentId','birthday','status','mustChangePassword','createdAt','createdBy'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'active'
        && request.resource.data.mustChangePassword == true
        && (
          // IT admin creates a teacher
          (isAdmin() && request.resource.data.role == 'teacher')
          // Teacher sign-up: automatic, no approval (temporary password, must be changed at first sign-in)
          || (request.auth.uid == uid && request.resource.data.role == 'teacher')
          // Student sign-up: Exam ID No. + birthday must match the teacher's student record, and the login email must be the Exam ID's
          || (request.auth.uid == uid && request.resource.data.role == 'student'
              && request.resource.data.birthday is string
              && studentRec(request.resource.data.studentId).birthday == request.resource.data.birthday
              && request.auth.token.email == request.resource.data.studentId.lower() + '@student.ark-exam.app')
          // A teacher (or the admin) creates a login for one of their own students
          || (isStaff() && request.resource.data.role == 'student'
              && studentRec(request.resource.data.studentId).ownerUid == request.auth.uid)
        );

      allow update:
        (isAdmin() && resource.data.role in ['teacher', 'student']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['active', 'suspended'])
        ||
        (signedIn() && request.auth.uid == uid && resource.data.mustChangePassword == true
          && request.resource.data.mustChangePassword == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'passwordChangedAt']));

      // Admin may remove any teacher/student profile; a teacher may remove the profile of their own student.
      allow delete: if (isAdmin() && resource.data.role != 'admin')
        || (isStaff() && resource.data.role == 'student' && studentRec(resource.data.studentId).ownerUid == request.auth.uid);
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /resetRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'employeeId', 'status', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 4 && request.resource.data.email.size() < 150
        && request.resource.data.employeeId is string && request.resource.data.employeeId.size() < 40
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.status in ['sent', 'dismissed', 'resolved'];
      allow delete: if false;
    }

    match /systemSettings/{id} {
      allow read: if liveAccount();
      allow write: if isAdmin();
    }

    // Counter used to hand out Exam ID No. that are unique across all teachers.
    match /counters/{id} {
      allow read, write: if isStaff();
    }

    /* ---------------- students ---------------- */
    // Document id = Exam ID No.
    match /students/{sid} {
      allow read: if isAdmin()
        || (isTeacher() && mayRead())
        || (hasProfile() && me().status == 'active' && me().role == 'student' && me().studentId == sid);
      allow create: if isStaff() && mine() && request.resource.data.number == sid;
      allow update: if (isStaff() && owns() && sameOwner())
        || (hasProfile() && me().role == 'student' && me().studentId == sid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountUid'])
            && request.resource.data.accountUid == request.auth.uid);
      allow delete: if isStaff() && owns();
    }

    /* ---------------- results ---------------- */
    match /scanResults/{id} {
      allow read:   if isAdmin() || (isTeacher() && mayRead())
                    || (isStudent() && resource.data.studentId == me().studentId);
      allow create: if isStaff() && mine();
      allow update: if isStaff() && owns() && sameOwner();
      allow delete: if isStaff() && owns();
    }

    /* ---------------- modules (teaching files, stored in chunks) ---------------- */
    match /modules/{id} {
      allow read:   if isAdmin() || (isTeacher() && mayRead())
                    || studentSees(resource.data.ownerUid, resource.data.classId);
      allow create: if isStaff() && mine();
      allow update: if isStaff() && owns() && sameOwner();
      allow delete: if isStaff() && owns();
    }
    match /moduleChunks/{id} {
      allow read:   if isAdmin() || (isTeacher() && mayRead())
                    || (isStudent() && studentSees(
                          get(/databases/$(database)/documents/modules/$(resource.data.moduleId)).data.ownerUid,
                          get(/databases/$(database)/documents/modules/$(resource.data.moduleId)).data.classId));
      allow create: if isStaff() && mine();
      allow update: if isStaff() && owns() && sameOwner();
      allow delete: if isStaff() && owns();
    }

    /* ---------------- other teacher-owned data ---------------- */
    match /{coll}/{id} {
      allow read:   if coll in ['classes','examinations','answerKeys','answerSheets'] && (isAdmin() || (isTeacher() && mayRead()));
      allow create: if coll in ['classes','examinations','answerKeys','answerSheets'] && isStaff() && mine();
      allow update: if coll in ['classes','examinations','answerKeys','answerSheets'] && isStaff() && owns() && sameOwner();
      allow delete: if coll in ['classes','examinations','answerKeys','answerSheets'] && isStaff() && owns();
    }
  }
}
