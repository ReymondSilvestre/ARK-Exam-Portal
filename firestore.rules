rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()    { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile()  { return signedIn() && exists(profilePath()); }
    function me()          { return get(profilePath()).data; }
    // Everyone except the Super Admin belongs to a school, and the school must be active.
    function schoolLive()  { return me().role == 'superadmin'
                              || (me().schoolId is string && get(/databases/$(database)/documents/schools/$(me().schoolId)).data.status == 'active'); }
    function liveAccount() { return hasProfile() && me().status == 'active' && me().mustChangePassword != true && schoolLive(); }
    function isSuper()     { return liveAccount() && me().role == 'superadmin'; }
    function isAdmin()     { return liveAccount() && me().role == 'admin'; }     // the school's IT admin
    function isTeacher()   { return liveAccount() && me().role == 'teacher'; }
    function isStaff()     { return isAdmin() || isTeacher(); }                  // the IT admin has every teacher feature
    function isStudent()   { return liveAccount() && me().role == 'student'; }

    function studentRec(sid) { return get(/databases/$(database)/documents/students/$(sid)).data; }
    function myStudent()     { return studentRec(me().studentId); }
    function classCode(c)    { return get(/databases/$(database)/documents/classCodes/$(c)).data; }

    // Documents a student may see from a teacher: the home teacher's own section (or "all sections"),
    // or any classroom the student joined with the teacher's classroom code.
    function studentSees(ownerUid, classId) {
      return isStudent() && (
        (ownerUid == myStudent().ownerUid && classId in [myStudent().classId, ''])
        || (exists(/databases/$(database)/documents/teacherLinks/$(me().studentId + '_' + ownerUid))
            && (classId == '' || exists(/databases/$(database)/documents/enrollments/$(me().studentId + '_' + classId)))));
    }
    // Online exams: the student's locked answers and the time the exam was opened
    function subOf(id) { return get(/databases/$(database)/documents/examSubmissions/$(id)).data; }
    function attOf(id) { return get(/databases/$(database)/documents/examAttempts/$(id)).data; }
    // A student may post ONE online result, and only for answers already locked in examSubmissions (the answers must be identical).
    // `manual` is not allowed here: only the teacher can award identification / essay points.
    function studentMayPost(id) {
      return isStudent()
        && request.resource.data.keys().hasOnly(['ownerUid','schoolId','examId','studentId','studentName','studentNumber','classId','className','answers',
             'correct','wrong','blank','multi','pending','total','points','maxPoints','pct','final','pass','teacherName','examTitle','subject','term','passingPct',
             'missedList','via','startedAt','submittedAt','scannedAt','reviewedFlags'])
        && request.resource.data.via == 'online'
        && request.resource.data.studentId == me().studentId
        && id == request.resource.data.examId + '_' + me().studentId
        && request.resource.data.schoolId == me().schoolId
        && request.resource.data.ownerUid == subOf(id).ownerUid
        && request.resource.data.answers == subOf(id).answers
        && request.resource.data.submittedAt == subOf(id).submittedAt
        && request.resource.data.startedAt == attOf(id).startedAt
        && request.resource.data.scannedAt == request.time;
    }
    // READS: a document that does not exist yet has resource == null (the scanner looks before it saves).
    function mayRead()   { return resource == null || resource.data.ownerUid == request.auth.uid; }
    function owns()      { return resource.data.ownerUid == request.auth.uid; }
    function mine()      { return request.resource.data.ownerUid == request.auth.uid; }
    function sameOwner() { return request.resource.data.ownerUid == resource.data.ownerUid; }
    function inMySchool(){ return resource.data.schoolId == me().schoolId; }
    function sameSchool(){ return request.resource.data.schoolId == me().schoolId; }

    /* ---------------- schools (registered by the Super Admin) ---------------- */
    match /schools/{id} {
      allow read: if hasProfile() && (me().role == 'superadmin' || me().schoolId == id);
      allow create: if isSuper() && request.resource.data.keys().hasOnly(['name','code','status','createdAt','createdBy'])
        && request.resource.data.code == id && request.resource.data.status == 'active';
      allow update: if (isSuper() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.status in ['active','suspended'])
        // The school's IT Admin can set their own display name and logo (shown in place of "ARK Exam Scanner").
        || (isAdmin() && me().schoolId == id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','logo','updatedAt'])
          && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80))
          && (!('logo' in request.resource.data) || (request.resource.data.logo is string && request.resource.data.logo.size() <= 900000)));
      // Deletion cascades through every record of the school. The superDeleteSchool / superClearSchoolData
      // Cloud Functions do this (and also remove the sign-in logins). Without them, the Super Admin page falls
      // back to deleting the same records from the browser: the Super Admin is therefore allowed to read
      // (list) and delete school data in the collections below. Remove the `isSuper() ||` read additions if
      // you only ever use the Cloud Functions and want the Super Admin unable to read school data.
      allow delete: if isSuper();
    }

    /* ---------------- accounts ---------------- */
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isSuper() || (isAdmin() && inMySchool());

      allow create: if request.resource.data.keys().hasOnly(
            ['uid','role','displayName','lastName','firstName','middleInitial','email','employeeId','studentId','birthday','status','mustChangePassword','createdAt','createdBy','schoolId','schoolName'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'active'
        && request.resource.data.mustChangePassword == true
        && (
          // Super Admin registers a school's IT admin (the school document is created in the same batch)
          (isSuper() && request.resource.data.role == 'admin'
              && existsAfter(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)))
          // School IT admin creates a faculty / teacher account in their own school
          || (isAdmin() && request.resource.data.role == 'teacher' && sameSchool())
          // A teacher (or the IT admin) creates a login for one of their own students
          || (isStaff() && request.resource.data.role == 'student' && sameSchool()
              && studentRec(request.resource.data.studentId).ownerUid == request.auth.uid)
        );

      allow update: if
        (isAdmin() && resource.data.role in ['teacher', 'student'] && inMySchool()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['active', 'suspended'])
        ||
        (isSuper() && resource.data.role == 'admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['active', 'suspended'])
        ||
        (signedIn() && request.auth.uid == uid && resource.data.mustChangePassword == true
          && request.resource.data.mustChangePassword == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'passwordChangedAt']));

      allow delete: if (isAdmin() && resource.data.role in ['teacher', 'student'] && inMySchool())
        || (isSuper() && resource.data.role in ['admin', 'teacher', 'student'])
        || (isStaff() && resource.data.role == 'student' && studentRec(resource.data.studentId).ownerUid == request.auth.uid);
    }

    match /auditLogs/{id} {
      allow read: if isSuper() || (isAdmin() && inMySchool());
      allow create: if (isSuper() || (isAdmin() && sameSchool())) && request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isSuper();
    }


    match /systemSettings/{id} {
      allow read: if liveAccount();
      allow write: if isSuper();
    }

    // Counter used to hand out Exam ID No. that are unique across all teachers and schools.
    match /counters/{id} {
      allow read, write: if isStaff();
    }

    /* ---------------- classroom codes ---------------- */
    // The code is the secret: anyone signed in who knows it can fetch ONE code document (no listing).
    match /classCodes/{code} {
      allow get: if liveAccount();
      allow list: if isSuper() || (isStaff() && resource.data.ownerUid == request.auth.uid);
      allow create: if isStaff() && mine() && sameSchool() && request.resource.data.code == code;
      allow update: if isStaff() && owns();
      allow delete: if (isStaff() && owns()) || isSuper();
    }
    // A student joins a classroom with the teacher's code. Document id = studentId_classId.
    match /enrollments/{id} {
      allow read: if isSuper() || (isStaff() && resource.data.ownerUid == request.auth.uid)
        || (isStudent() && resource.data.studentId == me().studentId);
      allow create: if isStudent()
        && request.resource.data.keys().hasOnly(['studentId','studentUid','studentName','studentNumber','classId','className','code','ownerUid','teacherName','schoolId','joinedAt'])
        && request.resource.data.studentId == me().studentId
        && request.resource.data.studentUid == request.auth.uid
        && id == me().studentId + '_' + request.resource.data.classId
        && request.resource.data.schoolId == me().schoolId
        && request.resource.data.joinedAt == request.time
        && classCode(request.resource.data.code).classId == request.resource.data.classId
        && classCode(request.resource.data.code).ownerUid == request.resource.data.ownerUid
        && classCode(request.resource.data.code).schoolId == me().schoolId;
      allow update: if false;
      allow delete: if (isStaff() && resource.data.ownerUid == request.auth.uid)
        || (isStudent() && resource.data.studentId == me().studentId) || isSuper();
    }
    // One link per (student, teacher): lets the student see that teacher's "all sections" modules.
    match /teacherLinks/{id} {
      allow read: if isSuper() || (isStaff() && resource.data.ownerUid == request.auth.uid)
        || (isStudent() && resource.data.studentId == me().studentId);
      allow create: if isStudent()
        && request.resource.data.keys().hasOnly(['studentId','ownerUid','classId','schoolId','createdAt'])
        && request.resource.data.studentId == me().studentId
        && id == me().studentId + '_' + request.resource.data.ownerUid
        && request.resource.data.schoolId == me().schoolId
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/enrollments/$(me().studentId + '_' + request.resource.data.classId))
        && getAfter(/databases/$(database)/documents/enrollments/$(me().studentId + '_' + request.resource.data.classId)).data.ownerUid == request.resource.data.ownerUid;
      allow update: if false;
      allow delete: if (isStaff() && resource.data.ownerUid == request.auth.uid)
        || (isStudent() && resource.data.studentId == me().studentId) || isSuper();
    }

    /* ---------------- students ---------------- */
    // Document id = Exam ID No. Owned by the adviser (home teacher) who created it.
    match /students/{sid} {
      allow read: if isSuper() || (isStaff() && mayRead()) || (isAdmin() && inMySchool())
        || (isStudent() && me().studentId == sid);
      allow create: if isStaff() && mine() && sameSchool() && request.resource.data.number == sid;
      allow update: if (isStaff() && owns() && sameOwner())
        || (isStudent() && me().studentId == sid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountUid'])
            && request.resource.data.accountUid == request.auth.uid);
      allow delete: if (isStaff() && owns()) || isSuper();
    }

    /* ---------------- results (a student sees results from EVERY teacher) ---------------- */
    match /scanResults/{id} {
      allow read:   if isSuper() || (isStaff() && mayRead()) || (isAdmin() && inMySchool())
                    || (isStudent() && resource.data.studentId == me().studentId);
      allow create: if (isStaff() && mine() && sameSchool()) || studentMayPost(id);
      allow update: if isStaff() && owns() && sameOwner();
      allow delete: if (isStaff() && owns()) || isSuper();
    }

    /* ---------------- modules (teaching files, stored in chunks) ---------------- */
    match /modules/{id} {
      allow read:   if isSuper() || (isStaff() && mayRead()) || studentSees(resource.data.ownerUid, resource.data.classId);
      allow create: if isStaff() && mine();
      allow update: if isStaff() && owns() && sameOwner();
      allow delete: if (isStaff() && owns()) || isSuper();
    }
    match /moduleChunks/{id} {
      allow read:   if isSuper() || (isStaff() && mayRead())
                    || studentSees(
                          get(/databases/$(database)/documents/modules/$(resource.data.moduleId)).data.ownerUid,
                          get(/databases/$(database)/documents/modules/$(resource.data.moduleId)).data.classId);
      allow create: if isStaff() && mine();
      allow update: if isStaff() && owns() && sameOwner();
      allow delete: if (isStaff() && owns()) || isSuper();
    }

    /* ---------------- online exams ---------------- */
    // examPapers: the student-readable copy of an online exam (questions and choices, NEVER the answer key).
    // The key lives in `examinations` (teacher only) and in `examKeys` (students may read it only AFTER they have submitted).
    match /examPapers/{id} {
      allow read:   if isSuper() || (isStaff() && mayRead()) || (isAdmin() && inMySchool())
                    || (studentSees(resource.data.ownerUid, resource.data.classId) && resource.data.open == true);
      allow create: if isStaff() && mine() && sameSchool();
      allow update: if isStaff() && owns() && sameOwner();
      allow delete: if (isStaff() && owns()) || isSuper();
    }
    match /examKeys/{id} {
      allow read:   if isSuper() || (isStaff() && mayRead()) || (isStudent() && exists(/databases/$(database)/documents/examSubmissions/$(id + '_' + me().studentId)));
      allow create: if isStaff() && mine() && sameSchool();
      allow update: if isStaff() && owns() && sameOwner();
      allow delete: if (isStaff() && owns()) || isSuper();
    }
    // examSubmissions: the student's answers, written once and locked (no update). Document id = examId_studentId.
    match /examSubmissions/{id} {
      allow read:   if isSuper() || (isStaff() && mayRead()) || (isStudent() && (resource == null || resource.data.studentId == me().studentId));
      allow create: if isStudent()
        && request.resource.data.keys().hasOnly(['examId','studentId','studentUid','ownerUid','schoolId','answers','submittedAt'])
        && request.resource.data.studentId == me().studentId
        && request.resource.data.studentUid == request.auth.uid
        && id == request.resource.data.examId + '_' + me().studentId
        && request.resource.data.schoolId == me().schoolId
        && request.resource.data.submittedAt == request.time
        && request.resource.data.answers is list && request.resource.data.answers.size() <= 100
        && get(/databases/$(database)/documents/examPapers/$(request.resource.data.examId)).data.open == true
        && get(/databases/$(database)/documents/examPapers/$(request.resource.data.examId)).data.ownerUid == request.resource.data.ownerUid
        && studentSees(request.resource.data.ownerUid, get(/databases/$(database)/documents/examPapers/$(request.resource.data.examId)).data.classId)
        && exists(/databases/$(database)/documents/examAttempts/$(id));
      allow update: if false;
      allow delete: if (isStaff() && owns()) || isSuper();   // "Retake"
    }
    // examAttempts: written when a student opens an exam (server time), so the time limit cannot be restarted. Document id = examId_studentId.
    match /examAttempts/{id} {
      allow read:   if isSuper() || (isStaff() && mayRead()) || (isStudent() && (resource == null || resource.data.studentId == me().studentId));
      allow create: if isStudent()
        && request.resource.data.keys().hasOnly(['examId','studentId','studentUid','ownerUid','schoolId','startedAt'])
        && request.resource.data.studentId == me().studentId
        && request.resource.data.studentUid == request.auth.uid
        && id == request.resource.data.examId + '_' + me().studentId
        && request.resource.data.schoolId == me().schoolId
        && request.resource.data.startedAt == request.time
        && get(/databases/$(database)/documents/examPapers/$(request.resource.data.examId)).data.open == true
        && get(/databases/$(database)/documents/examPapers/$(request.resource.data.examId)).data.ownerUid == request.resource.data.ownerUid
        && studentSees(request.resource.data.ownerUid, get(/databases/$(database)/documents/examPapers/$(request.resource.data.examId)).data.classId);
      allow update: if false;
      allow delete: if (isStaff() && owns()) || isSuper();   // "Retake": the teacher lets the student start over
    }

    /* ---------------- other teacher-owned data ---------------- */
    match /{coll}/{id} {
      allow read:   if coll in ['classes','examinations','answerKeys','answerSheets'] && (isSuper() || (isStaff() && mayRead()) || (isAdmin() && inMySchool()));
      allow create: if coll in ['classes','examinations','answerKeys','answerSheets'] && isStaff() && mine() && sameSchool();
      allow update: if coll in ['classes','examinations','answerKeys','answerSheets'] && isStaff() && owns() && sameOwner();
      allow delete: if coll in ['classes','examinations','answerKeys','answerSheets'] && ((isStaff() && owns()) || isSuper());
    }
  }
}
